;;; Commentary:

;; Writes the issues of one view to an Org file, so the Org agenda can
;; show them: due dates as deadlines, states as TODO keywords and
;; priorities as cookies.  Add `org-linear-agenda-file' to
;; `org-agenda-files' once, then run `org-linear-agenda-sync', or turn
;; on `org-linear-agenda-sync-mode' to sync on a timer.
;;
;; The file is generated: edits to it are overwritten.  Visiting it
;; gives the usual org-linear keys, so changes go to Linear.  From the
;; agenda, RET jumps to the issue, or bind `org-linear-agenda-set-state'
;; and `org-linear-agenda-set-priority' in `org-agenda-mode-map'.

;;; Code:

(require 'org)
(require 'org-agenda)
(require 'org-linear)

(defcustom org-linear-agenda-file
  (expand-file-name "linear.org" org-directory)
  "File that `org-linear-agenda-sync' writes.
Add it to `org-agenda-files'.  Anything in it is overwritten."
  :type 'file
  :group 'org-linear)

(defcustom org-linear-agenda-view nil
  "Name of the entry in `org-linear-views' that the agenda file shows.
Nil means the first view."
  :type '(choice (const :tag "First view" nil) string)
  :group 'org-linear)

(defcustom org-linear-agenda-sync-interval 15
  "Minutes between syncs in `org-linear-agenda-sync-mode'."
  :type 'natnum
  :group 'org-linear)

(defvar org-linear-agenda--timer nil
  "Timer of `org-linear-agenda-sync-mode'.")

(defconst org-linear-agenda--header
  "# Generated by org-linear.  Edits here are overwritten on the next sync.
# Use the org-linear keys (C-c C-t, C-c ,, ...) to change issues in Linear.
"
  "Text at the top of the agenda file.")

(defun org-linear-agenda--view ()
  "Return the view the agenda file shows."
  (or (if org-linear-agenda-view
          (assoc org-linear-agenda-view org-linear-views)
        (car org-linear-views))
      (user-error "No view named %S in `org-linear-views'" org-linear-agenda-view)))

(defun org-linear-agenda--file-p (&optional file)
  "Non-nil if FILE (default: the current buffer's file) is the agenda file."
  (let ((file (or file buffer-file-name)))
    (and file (file-exists-p file) (file-exists-p org-linear-agenda-file)
         (file-equal-p file org-linear-agenda-file))))

(defun org-linear-agenda--setup-buffer ()
  "Give the agenda file's buffer the org-linear keys, if this is it."
  (when (org-linear-agenda--file-p)
    (setq org-linear--refresh-function #'org-linear-agenda-sync)
    (org-linear-view-mode 1)))

(add-hook 'find-file-hook #'org-linear-agenda--setup-buffer)

(defun org-linear-agenda--write (text)
  "Write TEXT to the agenda file and update a buffer visiting it."
  (make-directory (file-name-directory org-linear-agenda-file) t)
  (let ((buffer (find-buffer-visiting org-linear-agenda-file)))
    (write-region text nil org-linear-agenda-file nil 'silent)
    (when buffer
      ;; Take the new file's modtime first, so changing the buffer to
      ;; the same text does not ask about a file changed on disk.
      (with-current-buffer buffer (set-visited-file-modtime))
      (org-linear--replace-contents buffer text)
      (with-current-buffer buffer
        (set-buffer-modified-p nil)
        (org-linear-agenda--setup-buffer)))))

(defun org-linear-agenda--redo-agendas ()
  "Rebuild open agenda buffers, so they show the new file."
  (dolist (buffer (buffer-list))
    (when (eq (buffer-local-value 'major-mode buffer) 'org-agenda-mode)
      (with-current-buffer buffer
        (save-window-excursion
          (ignore-errors (org-agenda-redo t)))))))

;;;###autoload
(defun org-linear-agenda-sync (&optional quiet)
  "Write the issues of `org-linear-agenda-view' to `org-linear-agenda-file'.
Open agenda buffers are rebuilt afterwards.  With QUIET, only report
failures."
  (interactive)
  (let ((view (org-linear-agenda--view)))
    (unless quiet (message "org-linear: syncing %s..." (car view)))
    (org-linear-api-issues
     (plist-get (cdr view) :filter)
     (lambda (issues)
       (org-linear-agenda--write
        (concat org-linear-agenda--header
                (org-linear-render-view (car view) issues)))
       (org-linear-agenda--redo-agendas)
       (unless quiet
         (message "org-linear: %d issue%s written to %s" (length issues)
                  (if (= (length issues) 1) "" "s")
                  (abbreviate-file-name org-linear-agenda-file))))
     #'org-linear--report)))

;;;###autoload
(define-minor-mode org-linear-agenda-sync-mode
  "Sync the Linear agenda file every `org-linear-agenda-sync-interval' minutes."
  :global t
  :group 'org-linear
  (when org-linear-agenda--timer
    (cancel-timer org-linear-agenda--timer)
    (setq org-linear-agenda--timer nil))
  (when org-linear-agenda-sync-mode
    (setq org-linear-agenda--timer
          (run-at-time 0 (* 60 (max 1 org-linear-agenda-sync-interval))
                       #'org-linear-agenda-sync t))))

;;;; Acting from the agenda

(defun org-linear-agenda--call (command)
  "Run COMMAND on the issue of the current agenda line."
  (let ((marker (or (org-get-at-bol 'org-hd-marker)
                    (org-get-at-bol 'org-marker)
                    (user-error "No entry on this line"))))
    (with-current-buffer (marker-buffer marker)
      (save-excursion
        (goto-char marker)
        (unless (org-entry-get nil "LINEAR_ID" t)
          (user-error "Not a Linear issue"))
        (call-interactively command)))))

;;;###autoload
(defun org-linear-agenda-set-state ()
  "Change the state in Linear of the issue on the current agenda line."
  (interactive)
  (org-linear-agenda--call #'org-linear-set-state))

;;;###autoload
(defun org-linear-agenda-set-priority ()
  "Change the priority in Linear of the issue on the current agenda line."
  (interactive)
  (org-linear-agenda--call #'org-linear-set-priority))

(provide 'org-linear-agenda)
;;; org-linear-agenda.el ends here
